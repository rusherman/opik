apiVersion: v1
kind: Secret
metadata:
  name: otel-sls-credentials
  namespace: opik
type: Opaque
stringData:
  SLS_ENDPOINT: "<your-sls-endpoint>.log.aliyuncs.com"
  SLS_PROJECT: "<your-sls-project>"
  SLS_LOGSTORE_TRACES: "<your-traces-logstore>"
  SLS_LOGSTORE_METRICS: "<your-metrics-logstore>"
  SLS_LOGSTORE_LOGS: "<your-logs-logstore>"
  SLS_ACCESS_KEY_ID: "<your-access-key-id>"
  SLS_ACCESS_KEY_SECRET: "<your-access-key-secret>"
